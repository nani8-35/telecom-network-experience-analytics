{
  "name": "Analytics",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "KPI",
        "columns": [
          {
            "name": "date",
            "dataType": "string",
            "sourceColumn": "date",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "observed_minutes",
            "dataType": "int64",
            "sourceColumn": "observed_minutes",
            "summarizeBy": "sum"
          },
          {
            "name": "downtime_minutes",
            "dataType": "double",
            "sourceColumn": "downtime_minutes",
            "summarizeBy": "sum"
          },
          {
            "name": "available_minutes",
            "dataType": "double",
            "sourceColumn": "available_minutes",
            "summarizeBy": "sum"
          },
          {
            "name": "subscriber_minutes_affected",
            "dataType": "double",
            "sourceColumn": "subscriber_minutes_affected",
            "summarizeBy": "sum"
          },
          {
            "name": "incidents",
            "dataType": "double",
            "sourceColumn": "incidents",
            "summarizeBy": "sum"
          },
          {
            "name": "sla_met",
            "dataType": "double",
            "sourceColumn": "sla_met",
            "summarizeBy": "sum"
          },
          {
            "name": "resolution_minutes",
            "dataType": "double",
            "sourceColumn": "resolution_minutes",
            "summarizeBy": "sum"
          }
        ],
        "measures": [
          {
            "name": "Network Uptime",
            "expression": "DIVIDE(SUM(KPI[available_minutes]), SUM(KPI[observed_minutes]))",
            "formatString": "0.00%"
          },
          {
            "name": "SLA Compliance",
            "expression": "DIVIDE(SUM(KPI[sla_met]), SUM(KPI[incidents]))",
            "formatString": "0.00%"
          },
          {
            "name": "MTTR Minutes",
            "expression": "DIVIDE(SUM(KPI[resolution_minutes]), SUM(KPI[incidents]))",
            "formatString": "0.00"
          },
          {
            "name": "Incident Count",
            "expression": "SUM(KPI[incidents])",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "KPI",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers, {{\"date\", type text}, {\"region\", type text}, {\"observed_minutes\", Int64.Type}, {\"downtime_minutes\", type number}, {\"available_minutes\", type number}, {\"subscriber_minutes_affected\", type number}, {\"incidents\", type number}, {\"sla_met\", type number}, {\"resolution_minutes\", type number}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      }
    ]
  }
}