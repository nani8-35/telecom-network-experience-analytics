{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "region_chart",
  "position": {
    "x": 20,
    "y": 170,
    "z": 0,
    "height": 500,
    "width": 900,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "KPI"
                    }
                  },
                  "Property": "region"
                }
              },
              "queryRef": "KPI.region"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "KPI"
                    }
                  },
                  "Property": "Network Uptime"
                }
              },
              "queryRef": "KPI.Network Uptime"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}